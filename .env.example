# Copia este archivo como .env.local para trabajar en local contra STAGING.
# .env.local no se sube a git. Sin estas variables la app usa PRODUCCIÓN.

# Entorno: "staging" muestra la banda de "ENTORNO DE PRUEBAS"
VITE_ENV=staging

# Firebase de staging (proyecto la-purisima-conchi-staging)
VITE_FIREBASE_API_KEY=AIzaSyBSx6j4tdEj3tWU5x-IySQgbjVV6ags3rE
VITE_FIREBASE_AUTH_DOMAIN=la-purisima-conchi-staging.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://la-purisima-conchi-staging-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=la-purisima-conchi-staging
VITE_FIREBASE_STORAGE_BUCKET=la-purisima-conchi-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=774923601009
VITE_FIREBASE_APP_ID=1:774923601009:web:77e26262dc2d03d0a2c7d0

# Solo para `npm run dev`: a dónde se redirige /api (sin esto, a PRODUCCIÓN)
API_PROXY_TARGET=https://tu-turnopwa-git-staging-lapurisimaconchi.vercel.app
# Token de Vercel (Settings → Deployment Protection → Protection Bypass for Automation).
# Es secreto: ponlo solo en .env.local, nunca aquí.
